<div class="d-flex justify-content-between"><h1><%= controller_name.humanize %></h1><%= link_to "Novo", url_for(action: :new), class: "btn btn-primary" %></div>
<table class="table"><% @registros.each do |registro| %><tr><td><%= link_to(registro.respond_to?(:nome) ? registro.nome : registro.to_s, url_for(action: :show, id: registro.id)) %></td><td><%= registro.respond_to?(:codigo) ? registro.codigo : nil %></td><td><%= registro.arquivado? ? "Arquivado" : "Ativo" %></td><td><% if registro.arquivado? %><%= button_to "Restaurar", url_for(action: :restaurar, id: registro.id), class: "btn btn-sm btn-outline-success" %><% else %><%= button_to "Arquivar", url_for(action: :arquivar, id: registro.id), class: "btn btn-sm btn-outline-warning" %><% end %></td></tr><% end %></table>
