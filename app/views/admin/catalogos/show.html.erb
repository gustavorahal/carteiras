<% nome = registro_titulo(@registro) %><% content_for :title, nome %>
<header class="page-header"><div><p class="page-eyebrow"><%= @registro.model_name.human %></p><h1 class="page-title"><%= nome %></h1></div><div class="page-actions"><%= status_badge(@registro.arquivado? ? "arquivado" : "ativo") %><%= link_to "Editar", url_for(action: :edit, id: @registro.id), class: "btn btn-primary" %></div></header>
<section class="surface"><dl class="row mb-0"><% @registro.attributes.except("id", "created_at", "updated_at", "arquivado_em").each do |atributo, valor| %><dt class="col-sm-4"><%= @registro.class.human_attribute_name(atributo) %></dt><dd class="col-sm-8"><%= formatar_atributo(atributo, valor) %></dd><% end %><dt class="col-sm-4">Estado</dt><dd class="col-sm-8"><%= display_estado(@registro.arquivado? ? "arquivado" : "ativo") %></dd></dl></section>
