<% content_for :title, "Cotações de ativos" %><header class="page-header"><div><p class="page-eyebrow">Mercado</p><h1 class="page-title">Cotações de ativos</h1><p class="page-subtitle">Preços automáticos e ajustes manuais.</p></div><div class="page-actions"><%= link_to "Nova cotação", new_admin_cotacao_ativo_path, class: "btn btn-primary" %></div></header>
<% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %>
<% if @cotacoes.any? %><div class="table-responsive table-shell"><table class="table align-middle"><thead><tr><th>Ativo</th><th>Data</th><th>Preço</th><th>Origem</th></tr></thead><tbody><% @cotacoes.each do |cotacao| %><tr><td><strong><%= cotacao.ativo.codigo %></strong></td><td><%= display_data(cotacao.data) %></td><td><%= form_with url: admin_cotacao_ativo_path(cotacao), method: :patch, scope: :cotacao_ativo, class: "input-group input-group-sm" do |f| %><%= f.text_field :preco, value: (@cotacao_com_erro_id == cotacao.id ? @preco_invalido : cotacao.preco.to_s("F")), class: "form-control text-end", aria: { label: "Preço de #{cotacao.ativo.codigo}" } %><%= f.submit "Corrigir", class: "btn btn-outline-primary" %><% end %></td><td><%= cotacao.manual? ? status_badge("pendente") : status_badge("calculado") %><span class="small ms-1"><%= cotacao.manual? ? "Manual" : "Automática" %></span><% if cotacao.manual? %><%= button_to "Liberar automação", liberar_automacao_admin_cotacao_ativo_path(cotacao), class: "btn btn-sm btn-link px-0 d-block" %><% end %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state"><strong>Nenhuma cotação</strong><span>Registre um preço ou aguarde a atualização automática.</span></div><% end %>
