<h1>Cotações de ativos</h1><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><%= link_to "Nova cotação", new_admin_cotacao_ativo_path, class: "btn btn-primary" %><table class="table"><% @cotacoes.each do |c| %><tr><td><%= c.ativo.codigo %></td><td><%= c.data %></td><td><%= form_with url: admin_cotacao_ativo_path(c), method: :patch, scope: :cotacao_ativo, class: "d-flex" do |f| %><%= f.text_field :preco, value: (@cotacao_com_erro_id == c.id ? @preco_invalido : c.preco.to_s("F")), class: "form-control form-control-sm" %><%= f.submit "Corrigir", class: "btn btn-sm btn-outline-primary" %><% end %></td><td><%= c.manual? ? "Manual" : "Automática" %> <% if c.manual? %><%= button_to "Liberar automação", liberar_automacao_admin_cotacao_ativo_path(c), class: "btn btn-sm btn-outline-secondary" %><% end %></td></tr><% end %></table>
