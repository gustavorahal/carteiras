<% content_for :title, "Nova cotação de ativo" %><header class="page-header"><div><p class="page-eyebrow">Mercado</p><h1 class="page-title">Nova cotação de ativo</h1><p class="page-subtitle">O preço manual prevalece até a automação ser liberada.</p></div></header><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><%= bootstrap_form_with model: @cotacao, url: admin_cotacoes_ativos_path, html: { class: "surface" } do |f| %><%= f.collection_select :ativo_id, Ativo.ativos.order(:codigo), :id, :codigo, label: "Ativo" %><%= f.date_field :data, label: "Data" %><%= f.text_field :preco, label: "Preço", inputmode: "decimal" %><div class="d-flex gap-2"><%= f.primary "Registrar cotação" %><%= link_to "Cancelar", admin_cotacoes_ativos_path, class: "btn btn-outline-secondary" %></div><% end %>
