<h1>Cotações de câmbio</h1><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><%= link_to "Nova cotação", new_admin_cotacao_cambio_path, class: "btn btn-primary" %><table class="table"><% @cotacoes.each do |c| %><tr><td><%= c.moeda_origem.codigo %>/<%= c.moeda_destino.codigo %></td><td><%= c.data %></td><td><%= form_with url: admin_cotacao_cambio_path(c), method: :patch, scope: :cotacao_cambio, class: "d-flex" do |f| %><%= f.text_field :taxa, value: (@cotacao_com_erro_id == c.id ? @taxa_invalida : c.taxa.to_s("F")), class: "form-control form-control-sm" %><%= f.submit "Corrigir", class: "btn btn-sm btn-outline-primary" %><% end %></td></tr><% end %></table>
