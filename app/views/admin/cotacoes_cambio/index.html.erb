<% content_for :title, "Cotações de câmbio" %><header class="page-header"><div><p class="page-eyebrow">Mercado</p><h1 class="page-title">Cotações de câmbio</h1><p class="page-subtitle">Taxas usadas para consolidar valores na moeda-base.</p></div><div class="page-actions"><%= link_to "Nova cotação", new_admin_cotacao_cambio_path, class: "btn btn-primary" %></div></header><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %>
<% if @cotacoes.any? %><div class="table-responsive table-shell"><table class="table align-middle"><thead><tr><th>Par</th><th>Data</th><th>Taxa</th></tr></thead><tbody><% @cotacoes.each do |cotacao| %><tr><td><strong><%= cotacao.moeda_origem.codigo %>/<%= cotacao.moeda_destino.codigo %></strong></td><td><%= display_data(cotacao.data) %></td><td><%= form_with url: admin_cotacao_cambio_path(cotacao), method: :patch, scope: :cotacao_cambio, class: "input-group input-group-sm" do |f| %><%= f.text_field :taxa, value: (@cotacao_com_erro_id == cotacao.id ? @taxa_invalida : cotacao.taxa.to_s("F")), class: "form-control text-end", aria: { label: "Taxa #{cotacao.moeda_origem.codigo}/#{cotacao.moeda_destino.codigo}" } %><%= f.submit "Corrigir", class: "btn btn-outline-primary" %><% end %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state"><strong>Nenhuma cotação de câmbio</strong><span>Registre a primeira taxa para consolidar moedas.</span></div><% end %>
