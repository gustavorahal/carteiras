<% content_for :title, "Nova cotação de câmbio" %><header class="page-header"><div><p class="page-eyebrow">Mercado</p><h1 class="page-title">Nova cotação de câmbio</h1><p class="page-subtitle">Informe quantas unidades da moeda de destino equivalem a uma unidade da origem.</p></div></header><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><%= bootstrap_form_with model: @cotacao, url: admin_cotacoes_cambio_path, html: { class: "surface" } do |f| %><div class="row g-3"><div class="col-md-6"><%= f.collection_select :moeda_origem_id, Moeda.ativos.order(:codigo), :id, :codigo, label: "Moeda de origem" %></div><div class="col-md-6"><%= f.collection_select :moeda_destino_id, Moeda.ativos.order(:codigo), :id, :codigo, label: "Moeda de destino" %></div></div><%= f.date_field :data, label: "Data" %><%= f.text_field :taxa, label: "Taxa", inputmode: "decimal" %><div class="d-flex gap-2"><%= f.primary "Registrar cotação" %><%= link_to "Cancelar", admin_cotacoes_cambio_index_path, class: "btn btn-outline-secondary" %></div><% end %>
