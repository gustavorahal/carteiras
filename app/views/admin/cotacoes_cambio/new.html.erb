<h1>Nova cotação de câmbio</h1><% if flash.now[:alert] %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><%= bootstrap_form_with model: @cotacao, url: admin_cotacoes_cambio_path do |f| %><%= f.collection_select :moeda_origem_id, Moeda.ativos.order(:codigo), :id, :codigo %><%= f.collection_select :moeda_destino_id, Moeda.ativos.order(:codigo), :id, :codigo %><%= f.date_field :data %><%= f.text_field :taxa %><%= f.primary %><% end %>
