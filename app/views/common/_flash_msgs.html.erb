<% tipos = { "alert" => "danger", "notice" => "success" } %>
<% if flash.any? %>
  <div class="flash-stack" aria-live="polite">
    <% flash.each do |nome, mensagem| %>
      <div class="alert alert-<%= tipos.fetch(nome, 'info') %> alert-dismissible fade show shadow-sm" role="alert">
        <%= mensagem %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% end %>
  </div>
<% end %>
