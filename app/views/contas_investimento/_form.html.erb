<% destino = conta.persisted? ? espaco_investidor_carteira_conta_path(@espaco, @investidor, @carteira, conta) : espaco_investidor_carteira_contas_path(@espaco, @investidor, @carteira) %>
<%= bootstrap_form_with model: conta, url: destino, method: (conta.persisted? ? :patch : :post) do |f| %>
  <%= f.text_field :nome, required: true %>
  <%= f.collection_select :instituicao_id, Instituicao.ativos.order(:nome), :id, :nome %>
  <%= f.text_field :identificador_externo %>
  <% if conta.new_record? %><%= f.collection_check_boxes :moeda_ids, Moeda.ativos.order(:codigo), :id, :codigo %><% end %>
  <%= f.primary %>
<% end %>
