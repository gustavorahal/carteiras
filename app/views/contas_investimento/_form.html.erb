<% destino = conta.persisted? ? espaco_investidor_carteira_conta_path(@espaco, @investidor, @carteira, conta) : espaco_investidor_carteira_contas_path(@espaco, @investidor, @carteira) %>
<%= bootstrap_form_with model: conta, url: destino, method: (conta.persisted? ? :patch : :post), html: { class: "surface" } do |f| %>
  <%= f.alert_message "Revise os dados abaixo." %><%= f.text_field :nome, label: "Nome da conta", autofocus: true %><%= f.collection_select :instituicao_id, Instituicao.ativos.order(:nome), :id, :nome, label: "Instituição" %><%= f.text_field :identificador_externo, label: "Identificador externo", help: "Opcional. Código usado pela instituição ou por importações." %>
  <% unless conta.persisted? %><%= f.collection_check_boxes :moeda_ids, Moeda.ativos.order(:codigo), :id, :codigo, label: "Moedas disponíveis", help: "Cada moeda cria uma conta de caixa separada." %><% end %>
  <div class="d-flex gap-2 mt-4"><%= f.primary conta.persisted? ? "Salvar alterações" : "Criar conta" %><%= link_to "Cancelar", [@espaco, @investidor, @carteira], class: "btn btn-outline-secondary" %></div>
<% end %>
