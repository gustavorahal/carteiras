<% content_for :title, "Desbloquear acesso" %>
<section class="card auth-card">
  <div class="card-body p-4 p-md-5">
    <p class="page-eyebrow">Conta bloqueada</p>
    <h1 class="h2">Reenviar desbloqueio</h1>
    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "vstack gap-3 mt-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div><%= f.label :email, "E-mail", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg" %></div>
      <%= f.submit "Reenviar instruções", class: "btn btn-primary btn-lg" %>
      <%= link_to "Voltar ao login", new_session_path(resource_name), class: "btn btn-link" %>
    <% end %>
  </div>
</section>
