<h1>Analisar arquivos financeiros</h1>
<p>Notas PDF XP/Avenue e extratos XLSX/CSV. Até 20 arquivos e 25 MB por envio; os arquivos não são armazenados.</p>
<%= form_with url: espaco_importacoes_financeiras_path(@espaco), method: :post, multipart: true, class: "vstack gap-3" do %>
  <div><%= label_tag :conta_investimento_id, "Conta de investimento", class: "form-label" %>
    <%= select_tag :conta_investimento_id, options_from_collection_for_select(@contas, :id, ->(c) { "#{c.carteira.nome} · #{c.instituicao.nome} · #{c.nome}" }), class: "form-select" %></div>
  <div><%= label_tag :arquivos, "Arquivos", class: "form-label" %><%= file_field_tag "arquivos[]", multiple: true, accept: ".pdf,.xlsx,.csv", class: "form-control" %></div>
  <%= submit_tag "Analisar", class: "btn btn-primary" %>
<% end %>
