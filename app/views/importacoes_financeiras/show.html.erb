<% content_for :title, @importacao.nome_original %>
<nav aria-label="Trilha de navegação"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to @espaco.nome, @espaco %></li><li class="breadcrumb-item"><%= link_to "Importações", espaco_importacoes_financeiras_path(@espaco) %></li><li class="breadcrumb-item active" aria-current="page">Detalhes</li></ol></nav>
<header class="page-header"><div><p class="page-eyebrow">Arquivo analisado</p><h1 class="page-title text-break"><%= @importacao.nome_original %></h1><p class="page-subtitle"><%= @importacao.conta_investimento.nome %></p></div><div class="page-actions"><%= status_badge(@importacao.estado) %></div></header>
<section class="surface mb-4"><dl class="row mb-0"><dt class="col-sm-3">Conta</dt><dd class="col-sm-9"><%= @importacao.conta_investimento.nome %></dd><dt class="col-sm-3">Formato</dt><dd class="col-sm-9"><%= @importacao.formato.to_s.humanize %></dd><dt class="col-sm-3">Versão do parser</dt><dd class="col-sm-9 mono"><%= @importacao.versao_parser %></dd><dt class="col-sm-3">Estado</dt><dd class="col-sm-9"><%= display_estado(@importacao.estado) %></dd></dl></section>
<% if flash.now[:alert].present? %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %><% if @importacao.erro_resumido.present? %><div class="alert alert-danger"><strong>Não foi possível concluir a análise.</strong><br><%= @importacao.erro_resumido %></div><% end %>

<% dados = @importacao.dados_extraidos %>
<% if dados["tipo_documento"] == "notas_negociacao" %>
  <%= form_with url: criar_rascunhos_espaco_importacoes_financeira_path(@espaco, @importacao), method: :post do %>
    <div class="section-stack"><% Array(dados["notas"]).each_with_index do |nota, ni| %><section class="surface"><div class="section-heading"><div><p class="page-eyebrow mb-1">Nota <%= nota["numero"] %></p><h2 class="h4"><%= display_data(nota["data_negociacao"]) %></h2></div><span class="small text-secondary">Liquidação <%= display_data(nota["data_liquidacao"]) %></span></div>
      <% unless nota["taxa_conversao_base"].present? %><div class="alert alert-warning"><%= label_tag nil, "Câmbio para a moeda-base", class: "form-label" %><%= text_field_tag "resolucoes[nota.#{ni}.taxa_conversao_base]", nil, class: "form-control", inputmode: "decimal" %></div><% end %>
      <div class="table-responsive table-shell"><table class="table table-sm align-middle"><thead><tr><th>Ativo</th><th>Natureza</th><th class="numeric">Quantidade</th><th class="numeric">Preço</th><th class="numeric">Custo alocado</th></tr></thead><tbody><% Array(nota["negociacoes"]).each_with_index do |linha, li| %><tr><td><% if linha["ativo_id"] %><strong><%= @ativos.find { |a| a.id == linha["ativo_id"] }&.codigo || linha["ticker"] %></strong><% else %><%= select_tag "resolucoes[nota.#{ni}.negociacao.#{li}.ativo_id]", options_from_collection_for_select(@ativos, :id, :codigo), include_blank: linha["ticker"].presence || linha["descricao"], class: "form-select form-select-sm", aria: { label: "Resolver ativo" } %><% end %></td><td><%= linha["natureza"].to_s.humanize %></td><td class="numeric"><%= display_numero(linha["quantidade"]) %></td><td class="numeric"><%= display_numero(linha["preco_unitario"]) %></td><td><%= text_field_tag "resolucoes[nota.#{ni}.custo.#{li}]", linha["custo_alocado"], class: "form-control form-control-sm text-end", inputmode: "decimal", aria: { label: "Custo alocado" } %></td></tr><% end %></tbody></table></div>
      <div class="row g-3 mt-1"><% { "Bruto" => nota["bruto"], "Custos" => nota["custo_operacional_total"], "Líquido calculado" => nota["liquido_calculado"], "Líquido informado" => nota["liquido_informado"], "Diferença" => nota["diferenca"] }.each do |rotulo, valor| %><div class="col-6 col-lg"><div class="metric-label"><%= rotulo %></div><div class="mono"><%= display_numero(valor) %></div></div><% end %></div>
    </section><% end %></div>
    <% if @importacao.estado.in?(%w[pendente analisada]) %><div class="mt-4"><%= submit_tag "Criar rascunhos", class: "btn btn-primary" %></div><% end %>
  <% end %>
<% elsif dados["tipo_documento"] == "extrato" %>
  <section class="surface mb-4"><div class="section-heading"><div><p class="page-eyebrow mb-1">Movimentações</p><h2 class="h3">Conciliação de caixa</h2></div></div><div class="table-responsive table-shell"><table class="table table-sm align-middle"><thead><tr><th>Liquidação</th><th>Descrição</th><th class="numeric">Valor</th><th class="numeric">Saldo informado</th><th>Situação</th></tr></thead><tbody><% @itens_extrato.each do |item| %><tr><td><%= display_data(item["data_liquidacao"]) %></td><td><%= item["descricao"] %></td><td class="numeric"><%= display_moeda(item["valor"], moeda: item["moeda"]) %></td><td class="numeric"><%= display_moeda(item["saldo_informado"], moeda: item["moeda"]) %></td><td><%= status_badge(item["estado_conciliacao"]) %></td></tr><% end %></tbody></table></div>
    <% if @importacao.estado.in?(%w[pendente analisada]) %><%= button_to "Conciliar e criar rascunhos inequívocos", criar_rascunhos_espaco_importacoes_financeira_path(@espaco, @importacao), class: "btn btn-primary mt-3" %><% end %>
  </section>
  <section class="surface mb-4"><div class="section-heading"><h2 class="h3">Conciliação de saldos</h2></div><div class="table-responsive table-shell"><table class="table table-sm saldos-conciliados align-middle"><thead><tr><th>Moeda</th><th>Data do saldo</th><th class="numeric">Informado</th><th class="numeric">Calculado na data</th><th class="numeric">Diferença</th></tr></thead><tbody><% @saldos_conciliados.each do |linha| %><tr><td><strong><%= linha[:caixa].moeda.codigo %></strong></td><td><%= display_data(linha[:data_saldo]) %></td><td class="numeric"><%= display_numero(linha[:informado]) %></td><td class="numeric"><%= display_numero(linha[:calculado]) %></td><td class="numeric"><%= display_numero(linha[:diferenca]) %></td></tr><% end %></tbody></table></div></section>
  <section class="surface"><div class="section-heading"><h2 class="h3">Conciliação de quantidades</h2></div><div class="table-responsive table-shell"><table class="table table-sm align-middle"><thead><tr><th>Ativo</th><th class="numeric">Informado</th><th class="numeric">Calculado</th><th class="numeric">Diferença</th></tr></thead><tbody><% @posicoes_calculadas.each do |posicao| %><% informada = @posicoes_informadas[posicao.ativo_id]&.dig("quantidade")&.then { |q| BigDecimal(q) } %><tr><td><strong><%= posicao.ativo.codigo %></strong></td><td class="numeric"><%= informada ? display_numero(informada) : "Não informado" %></td><td class="numeric"><%= display_numero(posicao.quantidade) %></td><td class="numeric"><%= informada ? display_numero(posicao.quantidade - informada) : "—" %></td></tr><% end %></tbody></table></div><p class="form-text mb-0 mt-3">Diferenças permanecem visíveis para decisão manual; nenhum ajuste é criado automaticamente.</p></section>
<% else %><div class="empty-state"><strong>Sem conteúdo estruturado</strong><span>A análise não produziu notas ou itens de extrato.</span></div><% end %>
