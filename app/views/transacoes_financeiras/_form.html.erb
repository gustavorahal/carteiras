<% dados = @atributos_formulario || {} %>
<% destino = if @correcao then corrigir_espaco_transacao_path(@espaco, @transacao) elsif @transacao&.persisted? then espaco_transacao_path(@espaco, @transacao) else espaco_transacoes_path(@espaco) end %>
<% if flash.now[:alert].present? %><div class="alert alert-danger"><%= flash.now[:alert] %></div><% end %>

<%= form_with url: destino, method: (@correcao ? :post : (@transacao&.persisted? ? :patch : :post)), class: "surface" do |f| %>
  <%= hidden_field_tag :tipo, @tipo %>
  <% if @transacao&.persisted? %><%= hidden_field_tag :investidor_id, @investidor&.id %><%= hidden_field_tag :id, @transacao.id %><% end %>
  <% if @correcao %><%= hidden_field_tag :correcao, "1" %><% end %>

  <fieldset class="form-section"><legend>Contexto</legend><div class="row g-3">
    <% unless @transacao&.persisted? %><div class="col-md-6"><%= label_tag :investidor_id, "Investidor", class: "form-label" %><%= select_tag :investidor_id, options_from_collection_for_select(@investidores, :id, :nome, @investidor&.id), class: "form-select" %></div><% end %>
    <% if @tipo == "nota_negociacao" %><div class="col-md-6"><%= label_tag "atributos_conta_caixa_id", "Conta de liquidação", class: "form-label" %><%= select_tag "atributos[conta_caixa_id]", options_from_collection_for_select(@caixas, :id, ->(c) { "#{c.conta_investimento.nome} · #{c.moeda.codigo}" }, dados[:conta_caixa_id]), class: "form-select" %></div><% end %>
  </div></fieldset>

  <% if @tipo == "nota_negociacao" %>
    <fieldset class="form-section"><legend>Datas e custos</legend><div class="row g-3">
      <div class="col-md-3"><%= label_tag "atributos_data_negociacao", "Data da negociação", class: "form-label" %><%= date_field_tag "atributos[data_negociacao]", dados[:data_negociacao] || Date.current, class: "form-control" %></div>
      <div class="col-md-3"><%= label_tag "atributos_data_liquidacao", "Data da liquidação", class: "form-label" %><%= date_field_tag "atributos[data_liquidacao]", dados[:data_liquidacao] || Date.current, class: "form-control" %></div>
      <div class="col-md-3"><%= label_tag "atributos_custo_operacional_total", "Custos operacionais", class: "form-label" %><%= text_field_tag "atributos[custo_operacional_total]", dados.fetch(:custo_operacional_total, "0"), class: "form-control", inputmode: "decimal" %></div>
      <div class="col-md-3"><%= label_tag "atributos_taxa_conversao_base", "Taxa para a moeda-base", class: "form-label" %><%= text_field_tag "atributos[taxa_conversao_base]", dados.fetch(:taxa_conversao_base, "1"), class: "form-control", inputmode: "decimal" %></div>
    </div></fieldset>
    <fieldset class="form-section" data-controller="negociacoes"><legend>Negociações</legend>
      <% linhas = Array(dados[:negociacoes]); linhas = [{}] if linhas.empty? %><div data-negociacoes-target="linhas"><% linhas.each do |linha| %><%= render "linha_negociacao", linha: %><% end %></div>
      <div class="d-flex flex-wrap align-items-center gap-3 mt-3"><button type="button" class="btn btn-sm btn-outline-primary" data-action="negociacoes#adicionar">Adicionar negociação</button><span class="form-text mt-0">A ordem visual define a aplicação econômica e o resíduo do rateio.</span></div>
    </fieldset>
  <% elsif @tipo == "provento" %>
    <fieldset class="form-section"><legend>Provento</legend><div class="row g-3">
      <div class="col-md-6"><%= label_tag "atributos_conta_caixa_id", "Conta de recebimento", class: "form-label" %><%= select_tag "atributos[conta_caixa_id]", options_from_collection_for_select(@caixas, :id, ->(c) { "#{c.conta_investimento.nome} · #{c.moeda.codigo}" }, dados[:conta_caixa_id]), class: "form-select" %></div>
      <div class="col-md-3"><%= label_tag "atributos_ativo_id", "Ativo", class: "form-label" %><%= select_tag "atributos[ativo_id]", options_from_collection_for_select(@ativos, :id, :codigo, dados[:ativo_id]), class: "form-select" %></div>
      <div class="col-md-3"><%= label_tag "atributos_tipo_provento", "Tipo", class: "form-label" %><%= select_tag "atributos[tipo_provento]", options_for_select(%w[dividendo jcp rendimento juros outro].map { |tipo| [tipo.humanize, tipo] }, dados[:tipo_provento]), class: "form-select" %></div>
      <div class="col-md-3"><%= label_tag "atributos_data_base", "Data-base", class: "form-label" %><%= date_field_tag "atributos[data_base]", dados[:data_base] || Date.current, class: "form-control" %></div><div class="col-md-3"><%= label_tag "atributos_data_pagamento", "Data de pagamento", class: "form-label" %><%= date_field_tag "atributos[data_pagamento]", dados[:data_pagamento] || Date.current, class: "form-control" %></div>
      <% { quantidade_referencia: "Quantidade de referência", valor_bruto: "Valor bruto", retencoes: "Retenções", taxa_conversao_base: "Taxa para a moeda-base" }.each do |campo, rotulo| %><div class="col-md-3"><%= label_tag "atributos_#{campo}", rotulo, class: "form-label" %><%= text_field_tag "atributos[#{campo}]", dados.fetch(campo, campo == :taxa_conversao_base ? "1" : "0"), class: "form-control", inputmode: "decimal" %></div><% end %>
    </div></fieldset>
  <% elsif @tipo == "saldo_inicial" %>
    <fieldset class="form-section"><legend>Posição inicial</legend><div class="row g-3">
      <div class="col-md-6"><%= label_tag "atributos_conta_investimento_id", "Conta de investimento", class: "form-label" %><%= select_tag "atributos[conta_investimento_id]", options_from_collection_for_select(@contas_investimento, :id, ->(c) { "#{c.carteira.nome} · #{c.nome}" }, dados[:conta_investimento_id]), class: "form-select" %></div>
      <div class="col-md-3"><%= label_tag "atributos_ativo_id", "Ativo", class: "form-label" %><%= select_tag "atributos[ativo_id]", options_from_collection_for_select(@ativos, :id, :codigo, dados[:ativo_id]), class: "form-select" %></div>
      <div class="col-md-3"><%= label_tag "atributos_quantidade", "Quantidade", class: "form-label" %><%= text_field_tag "atributos[quantidade]", dados[:quantidade], class: "form-control", inputmode: "decimal" %></div>
    </div></fieldset>
    <fieldset class="form-section"><legend>Custo conhecido</legend><p class="form-text">Preencha um único modo: preço médio ou custo total.</p><div class="row g-3">
      <div class="col-md-6"><%= label_tag "atributos_preco_medio_local", "Preço médio na moeda do ativo", class: "form-label" %><%= text_field_tag "atributos[preco_medio_local]", dados[:preco_medio_local], class: "form-control", inputmode: "decimal" %></div>
      <div class="col-md-6"><%= label_tag "atributos_preco_medio_base", "Preço médio na moeda-base", class: "form-label" %><%= text_field_tag "atributos[preco_medio_base]", dados[:preco_medio_base], class: "form-control", inputmode: "decimal" %></div>
      <div class="col-md-6"><%= label_tag "atributos_custo_total_local", "Custo total na moeda do ativo", class: "form-label" %><%= text_field_tag "atributos[custo_total_local]", dados[:custo_total_local], class: "form-control", inputmode: "decimal" %></div>
      <div class="col-md-6"><%= label_tag "atributos_custo_total_base", "Custo total na moeda-base", class: "form-label" %><%= text_field_tag "atributos[custo_total_base]", dados[:custo_total_base], class: "form-control", inputmode: "decimal" %></div>
      <div class="col-md-6"><%= label_tag "atributos_fonte_custo", "Fonte do custo", class: "form-label" %><%= select_tag "atributos[fonte_custo]", options_for_select([["Informado manualmente", "manual"], ["XP", "xp"], ["Avenue", "avenue"], ["Planilha", "planilha"], ["Outra", "outra"]], dados[:fonte_custo] || "manual"), class: "form-select" %></div>
      <div class="col-md-6"><%= label_tag "atributos_data_efetiva", "Data efetiva", class: "form-label" %><%= date_field_tag "atributos[data_efetiva]", dados[:data_efetiva] || Date.current, class: "form-control" %></div>
    </div><p class="form-text mb-0 mt-3">Inaugura uma posição documentada sem gerar caixa. O custo canônico é calculado a partir do preço médio informado.</p></fieldset>
  <% elsif @tipo == "transferencia_custodia" %>
    <fieldset class="form-section"><legend>Transferência</legend><div class="row g-3">
      <div class="col-md-6"><%= label_tag "atributos_conta_origem_id", "Conta de origem", class: "form-label" %><%= select_tag "atributos[conta_origem_id]", options_from_collection_for_select(@contas_investimento, :id, ->(c) { "#{c.carteira.nome} · #{c.nome}" }, dados[:conta_origem_id]), class: "form-select" %></div>
      <div class="col-md-6"><%= label_tag "atributos_conta_destino_id", "Conta de destino", class: "form-label" %><%= select_tag "atributos[conta_destino_id]", options_from_collection_for_select(@contas_investimento, :id, ->(c) { "#{c.carteira.nome} · #{c.nome}" }, dados[:conta_destino_id]), class: "form-select" %></div>
      <div class="col-md-4"><%= label_tag "atributos_ativo_id", "Ativo", class: "form-label" %><%= select_tag "atributos[ativo_id]", options_from_collection_for_select(@ativos, :id, :codigo, dados[:ativo_id]), class: "form-select" %></div><div class="col-md-4"><%= label_tag "atributos_quantidade", "Quantidade", class: "form-label" %><%= text_field_tag "atributos[quantidade]", dados[:quantidade], class: "form-control", inputmode: "decimal" %></div><div class="col-md-4"><%= label_tag "atributos_data_efetiva", "Data efetiva", class: "form-label" %><%= date_field_tag "atributos[data_efetiva]", dados[:data_efetiva] || Date.current, class: "form-control" %></div>
    </div></fieldset>
  <% elsif @tipo == "evento_corporativo" %>
    <fieldset class="form-section"><legend>Evento</legend><div class="row g-3">
      <div class="col-md-4"><%= label_tag "atributos_tipo_evento", "Tipo de evento", class: "form-label" %><%= select_tag "atributos[tipo_evento]", options_for_select(EventoCorporativo::TIPOS.map { |tipo| [tipo.humanize, tipo] }, dados[:tipo_evento]), class: "form-select" %></div><div class="col-md-8"><%= label_tag "atributos_conta_investimento_id", "Conta de investimento", class: "form-label" %><%= select_tag "atributos[conta_investimento_id]", options_from_collection_for_select(@contas_investimento, :id, ->(c) { "#{c.carteira.nome} · #{c.nome}" }, dados[:conta_investimento_id]), class: "form-select" %></div>
      <div class="col-md-4"><%= label_tag "atributos_ativo_origem_id", "Ativo de origem", class: "form-label" %><%= select_tag "atributos[ativo_origem_id]", options_from_collection_for_select(@ativos, :id, :codigo, dados[:ativo_origem_id]), class: "form-select" %></div><div class="col-md-4"><%= label_tag "atributos_ativo_destino_id", "Ativo de destino", class: "form-label" %><%= select_tag "atributos[ativo_destino_id]", options_from_collection_for_select(@ativos, :id, :codigo, dados[:ativo_destino_id]), include_blank: "Não se aplica", class: "form-select" %></div><div class="col-md-2"><%= label_tag "atributos_quantidade_final", "Quantidade final", class: "form-label" %><%= text_field_tag "atributos[quantidade_final]", dados[:quantidade_final], class: "form-control", inputmode: "decimal" %></div><div class="col-md-2"><%= label_tag "atributos_data_efetiva", "Data efetiva", class: "form-label" %><%= date_field_tag "atributos[data_efetiva]", dados[:data_efetiva] || Date.current, class: "form-control" %></div>
    </div><p class="form-text mb-0 mt-3">Conversão e incorporação exigem ativo de destino; os demais eventos preservam o ativo.</p></fieldset>
  <% else %>
    <% movimento = @movimento || params[:movimento].presence_in(%w[aporte resgate transferencia cambio]) || "aporte" %><%= hidden_field_tag "atributos[tipo_movimentacao]", movimento %>
    <fieldset class="form-section"><legend>Movimentação de caixa</legend><nav class="nav nav-pills gap-2 mb-4" aria-label="Tipo de movimentação"><% { "aporte" => "Aporte", "resgate" => "Resgate", "transferencia" => "Transferência", "cambio" => "Câmbio" }.each do |valor, rotulo| %><%= link_to rotulo, new_espaco_transacao_path(@espaco, tipo: @tipo, movimento: valor), class: class_names("nav-link border", active: movimento == valor) %><% end %></nav><div class="row g-3">
      <% if %w[resgate transferencia cambio].include?(movimento) %><div class="col-md-6"><%= label_tag "atributos_conta_caixa_origem_id", "Conta de origem", class: "form-label" %><%= select_tag "atributos[conta_caixa_origem_id]", options_from_collection_for_select(@caixas, :id, ->(c) { "#{c.conta_investimento.nome} · #{c.moeda.codigo}" }, dados[:conta_caixa_origem_id]), class: "form-select" %></div><% end %>
      <% if %w[aporte transferencia cambio].include?(movimento) %><div class="col-md-6"><%= label_tag "atributos_conta_caixa_destino_id", "Conta de destino", class: "form-label" %><%= select_tag "atributos[conta_caixa_destino_id]", options_from_collection_for_select(@caixas, :id, ->(c) { "#{c.conta_investimento.nome} · #{c.moeda.codigo}" }, dados[:conta_caixa_destino_id]), class: "form-select" %></div><% end %>
      <% if movimento == "cambio" %><div class="col-md-4"><%= label_tag "atributos_valor_origem", "Valor de origem", class: "form-label" %><%= text_field_tag "atributos[valor_origem]", dados[:valor_origem], class: "form-control", inputmode: "decimal" %></div><div class="col-md-4"><%= label_tag "atributos_valor_destino", "Valor de destino", class: "form-label" %><%= text_field_tag "atributos[valor_destino]", dados[:valor_destino], class: "form-control", inputmode: "decimal" %></div><% else %><div class="col-md-4"><%= label_tag "atributos_valor", "Valor", class: "form-label" %><%= text_field_tag "atributos[valor]", dados[:valor], class: "form-control", inputmode: "decimal" %></div><% end %>
      <div class="col-md-4"><%= label_tag "atributos_data_efetiva", "Data efetiva", class: "form-label" %><%= date_field_tag "atributos[data_efetiva]", dados[:data_efetiva] || Date.current, class: "form-control" %></div>
    </div></fieldset>
  <% end %>

  <fieldset class="form-section"><legend>Observações</legend><%= label_tag "atributos_observacao", "Observação", class: "form-label" %><%= text_area_tag "atributos[observacao]", dados[:observacao], class: "form-control", rows: 3, placeholder: "Contexto opcional para auditoria" %>
    <details class="mt-3"><summary class="small fw-semibold">Opções avançadas</summary><div class="row g-3 mt-1"><% unless @transacao&.persisted? %><div class="col-md-6"><%= label_tag :chave_idempotencia, "Chave de idempotência", class: "form-label" %><%= text_field_tag :chave_idempotencia, nil, class: "form-control", autocomplete: "off" %><div class="form-text">Use apenas em integrações ou reenvios controlados.</div></div><% end %><div class="col-md-6"><%= label_tag "atributos_ordem_na_data", "Ordem no dia", class: "form-label" %><%= number_field_tag "atributos[ordem_na_data]", dados[:ordem_na_data], min: 1, class: "form-control" %><div class="form-text">Deixe vazio para atribuição automática.</div></div></div></details>
  </fieldset>

  <div class="d-flex flex-wrap gap-2 mt-4"><%= f.submit(@correcao ? "Aplicar correção" : (@transacao&.persisted? ? "Atualizar rascunho" : "Criar rascunho"), class: "btn btn-primary") %><%= button_tag "Calcular prévia", formaction: prever_espaco_transacoes_path(@espaco), formmethod: "post", class: "btn btn-outline-secondary" %><%= link_to "Cancelar", @transacao&.persisted? ? espaco_transacao_path(@espaco, @transacao) : espaco_transacoes_path(@espaco), class: "btn btn-link" %></div>
<% end %>

<%= render "previa", previa: @previa if @previa %>
