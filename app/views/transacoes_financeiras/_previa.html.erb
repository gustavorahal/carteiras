<% resumo = previa.to_h.deep_symbolize_keys %>
<% detalhe = resumo[:detalhe_normalizado] || {} %>
<% ativos_por_id = Array(@ativos).index_by(&:id) %>
<section class="surface mt-4" aria-label="Prévia da transação">
  <div class="section-heading"><div><p class="page-eyebrow mb-1">Resumo dos efeitos</p><h2 class="h3">Prévia antes da confirmação</h2></div><%= status_badge("rascunho") %></div>
  <dl class="row mb-4"><dt class="col-sm-3">Tipo</dt><dd class="col-sm-9"><%= display_tipo(resumo[:tipo]) %></dd><dt class="col-sm-3">Competência</dt><dd class="col-sm-9"><%= display_data(resumo[:data_competencia]) %></dd><dt class="col-sm-3">Observação</dt><dd class="col-sm-9"><%= detalhe[:observacao].presence || "—" %></dd></dl>
  <% if Array(detalhe[:negociacoes]).any? %><h3 class="h5">Negociações</h3><div class="table-responsive table-shell mb-4"><table class="table table-sm align-middle"><thead><tr><th>Ativo</th><th>Natureza</th><th class="numeric">Quantidade</th><th class="numeric">Preço</th><th class="numeric">Custo</th></tr></thead><tbody><% Array(detalhe[:negociacoes]).each do |linha| %><tr><td><strong><%= ativos_por_id[linha[:ativo_id]]&.codigo || "Ativo ##{linha[:ativo_id]}" %></strong></td><td><%= linha[:natureza].to_s.humanize %></td><td class="numeric"><%= display_numero(linha[:quantidade]) %></td><td class="numeric"><%= display_numero(linha[:preco_unitario]) %></td><td class="numeric"><%= display_numero(linha[:custo_alocado]) %></td></tr><% end %></tbody></table></div><% end %>
  <% if Array(resumo[:lancamentos]).any? %><h3 class="h5">Movimentos de caixa previstos</h3><div class="table-responsive table-shell mb-4"><table class="table table-sm align-middle"><thead><tr><th>Data</th><th>Natureza</th><th class="numeric">Valor</th></tr></thead><tbody><% Array(resumo[:lancamentos]).each do |linha| %><tr><td><%= display_data(linha[:data_efetiva]) %></td><td><%= linha[:natureza].to_s.humanize %></td><td class="numeric"><%= display_numero(linha[:valor]) %></td></tr><% end %></tbody></table></div><% end %>
  <% if Array(resumo[:posicoes_resultantes]).any? %><h3 class="h5">Posições resultantes</h3><div class="table-responsive table-shell mb-4"><table class="table table-sm align-middle"><thead><tr><th>Ativo</th><th class="numeric">Quantidade</th><th class="numeric">Custo local</th><th class="numeric">Custo base</th></tr></thead><tbody><% Array(resumo[:posicoes_resultantes]).each do |linha| %><tr><td><strong><%= ativos_por_id[linha[:ativo_id]]&.codigo || "Ativo ##{linha[:ativo_id]}" %></strong></td><td class="numeric"><%= display_numero(linha[:quantidade]) %></td><td class="numeric"><%= display_numero(linha[:custo_total_local]) %></td><td class="numeric"><%= display_numero(linha[:custo_total_base]) %></td></tr><% end %></tbody></table></div><% end %>
  <details class="technical-details"><summary>Ver dados técnicos da prévia</summary><pre><%= JSON.pretty_generate(previa.to_h) %></pre></details>
</section>
