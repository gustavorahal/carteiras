<div class="d-flex justify-content-between"><h1>Transações</h1>
  <% if !@espaco.arquivado? && current_user.pode_editar?(@espaco) %><div><%= link_to "Novo aporte", new_espaco_transacao_path(@espaco, tipo: "movimentacao_caixa", movimento: "aporte"), class: "btn btn-primary" %>
  <%= link_to "Nova nota", new_espaco_transacao_path(@espaco, tipo: "nota_negociacao"), class: "btn btn-outline-primary" %>
  <%= link_to "Novo provento", new_espaco_transacao_path(@espaco, tipo: "provento"), class: "btn btn-outline-primary" %>
  <%= link_to "Saldo inicial", new_espaco_transacao_path(@espaco, tipo: "saldo_inicial"), class: "btn btn-outline-secondary" %>
  <%= link_to "Transferir custódia", new_espaco_transacao_path(@espaco, tipo: "transferencia_custodia"), class: "btn btn-outline-secondary" %>
  <%= link_to "Evento corporativo", new_espaco_transacao_path(@espaco, tipo: "evento_corporativo"), class: "btn btn-outline-secondary" %></div><% end %>
</div>
<%= form_with url: espaco_transacoes_path(@espaco), method: :get, class: "row g-2 my-3" do |f| %>
  <div class="col"><%= f.collection_select :investidor_id, @espaco.investidores.order(:nome), :id, :nome, { include_blank: "Todos os investidores", selected: params[:investidor_id] }, class: "form-select" %></div>
  <div class="col"><%= f.collection_select :carteira_id, @carteiras, :id, :nome, { include_blank: "Todas as carteiras", selected: params[:carteira_id] }, class: "form-select" %></div>
  <div class="col"><%= f.select :tipo, TransacaoFinanceira::TIPOS, { include_blank: "Todos os tipos", selected: params[:tipo] }, class: "form-select" %></div>
  <div class="col"><%= f.select :estado, TransacaoFinanceira::ESTADOS, { include_blank: "Todos os estados", selected: params[:estado] }, class: "form-select" %></div>
  <div class="col"><%= f.date_field :inicio, value: params[:inicio], class: "form-control" %></div><div class="col"><%= f.date_field :fim, value: params[:fim], class: "form-control" %></div>
  <div class="col"><%= f.submit "Filtrar", class: "btn btn-outline-primary" %></div>
<% end %>
<table class="table"><thead><tr><th>Data</th><th>Investidor</th><th>Tipo</th><th>Estado</th></tr></thead><tbody>
  <% @transacoes.each do |transacao| %><tr>
    <td><%= link_to transacao.data_competencia, espaco_transacao_path(@espaco, transacao) %></td><td><%= transacao.investidor.nome %></td><td><%= transacao.tipo.humanize %></td><td><%= transacao.estado %></td>
  </tr><% end %>
</tbody></table>
