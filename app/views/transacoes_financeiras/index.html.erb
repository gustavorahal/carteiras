<% content_for :title, "Transações" %>
<nav aria-label="Trilha de navegação"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to @espaco.nome, @espaco %></li><li class="breadcrumb-item active" aria-current="page">Transações</li></ol></nav>
<header class="page-header">
  <div><p class="page-eyebrow">Livro financeiro</p><h1 class="page-title">Transações</h1><p class="page-subtitle">Rascunhos, fatos confirmados e correções do espaço.</p></div>
<% if !@espaco.arquivado? && current_user.pode_editar?(@espaco) %><div class="page-actions"><div class="dropdown"><button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Nova transação</button><ul class="dropdown-menu dropdown-menu-end shadow"><li><h6 class="dropdown-header">Caixa e renda</h6></li><li><%= link_to "Aporte ou movimentação", new_espaco_transacao_path(@espaco, tipo: "movimentacao_caixa", movimento: "aporte"), class: "dropdown-item" %></li><li><%= link_to "Saldo inicial de caixa", new_espaco_transacao_path(@espaco, tipo: "saldo_inicial_caixa"), class: "dropdown-item" %></li><li><%= link_to "Provento", new_espaco_transacao_path(@espaco, tipo: "provento"), class: "dropdown-item" %></li><li><hr class="dropdown-divider"></li><li><h6 class="dropdown-header">Investimentos</h6></li><li><%= link_to "Nota de negociação", new_espaco_transacao_path(@espaco, tipo: "nota_negociacao"), class: "dropdown-item" %></li><li><%= link_to "Saldo inicial de posição", new_espaco_transacao_path(@espaco, tipo: "saldo_inicial"), class: "dropdown-item" %></li><li><%= link_to "Transferência de custódia", new_espaco_transacao_path(@espaco, tipo: "transferencia_custodia"), class: "dropdown-item" %></li><li><%= link_to "Evento corporativo", new_espaco_transacao_path(@espaco, tipo: "evento_corporativo"), class: "dropdown-item" %></li></ul></div></div><% end %>
</header>

<section class="surface mb-4"><details <%= "open" if params.slice(:investidor_id, :carteira_id, :tipo, :estado, :inicio, :fim).values.any?(&:present?) %>><summary class="fw-semibold">Filtrar transações</summary>
  <%= form_with url: espaco_transacoes_path(@espaco), method: :get, class: "row g-3 align-items-end mt-1" do |f| %>
    <div class="col-md-6 col-xl-3"><%= f.label :investidor_id, "Investidor", class: "form-label" %><%= f.collection_select :investidor_id, @espaco.investidores.order(:nome), :id, :nome, { include_blank: "Todos", selected: params[:investidor_id] }, class: "form-select" %></div>
    <div class="col-md-6 col-xl-3"><%= f.label :carteira_id, "Carteira", class: "form-label" %><%= f.collection_select :carteira_id, @carteiras, :id, :nome, { include_blank: "Todas", selected: params[:carteira_id] }, class: "form-select" %></div>
    <div class="col-md-6 col-xl-3"><%= f.label :tipo, "Tipo", class: "form-label" %><%= f.select :tipo, TransacaoFinanceira::TIPOS.map { |tipo| [display_tipo(tipo), tipo] }, { include_blank: "Todos", selected: params[:tipo] }, class: "form-select" %></div>
    <div class="col-md-6 col-xl-3"><%= f.label :estado, "Estado", class: "form-label" %><%= f.select :estado, TransacaoFinanceira::ESTADOS.map { |estado| [display_estado(estado), estado] }, { include_blank: "Todos", selected: params[:estado] }, class: "form-select" %></div>
    <div class="col-md-3"><%= f.label :inicio, "Desde", class: "form-label" %><%= f.date_field :inicio, value: params[:inicio], class: "form-control" %></div><div class="col-md-3"><%= f.label :fim, "Até", class: "form-label" %><%= f.date_field :fim, value: params[:fim], class: "form-control" %></div>
    <div class="col-md-6 d-flex gap-2"><%= f.submit "Aplicar filtros", class: "btn btn-primary flex-grow-1" %><%= link_to "Limpar", espaco_transacoes_path(@espaco), class: "btn btn-outline-secondary" %></div>
  <% end %>
</details></section>

<% if @transacoes.any? %>
  <div class="table-responsive table-shell desktop-table"><table class="table align-middle"><thead><tr><th>Competência</th><th>Investidor</th><th>Tipo</th><th>Estado</th><th></th></tr></thead><tbody><% @transacoes.each do |transacao| %><tr><td class="mono"><%= display_data(transacao.data_competencia) %></td><td><%= transacao.investidor.nome %></td><td><%= display_tipo(transacao.tipo) %></td><td><%= status_badge(transacao.estado) %></td><td class="text-end"><%= link_to "Ver detalhes", espaco_transacao_path(@espaco, transacao), class: "btn btn-sm btn-outline-primary" %></td></tr><% end %></tbody></table></div>
  <div class="mobile-cards"><% @transacoes.each do |transacao| %><%= link_to espaco_transacao_path(@espaco, transacao), class: "card mb-3 text-decoration-none text-body" do %><div class="card-body"><div class="d-flex justify-content-between gap-3 mb-2"><strong><%= display_tipo(transacao.tipo) %></strong><%= status_badge(transacao.estado) %></div><div class="small text-secondary"><%= transacao.investidor.nome %> · <%= display_data(transacao.data_competencia) %></div></div><% end %><% end %></div>
<% else %><div class="empty-state"><strong>Nenhuma transação encontrada</strong><span>Ajuste os filtros ou crie uma nova transação.</span></div><% end %>
